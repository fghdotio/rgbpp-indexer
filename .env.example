# Environment overrides.
#
# This is the complete list -- the binary reads exactly these and nothing else, so
# policy knobs (the sweep, verify and log sections) are absent on purpose: they live
# only in the TOML config and setting them here would silently do nothing.
#
# The split: the environment carries deployment identity and the few throughput
# settings that depend on whether the backing services are public or self-hosted.
# Everything else stays in the config file, where it is reviewable as a set.
DATABASE_URL=postgres://rgbpp:rgbpp@localhost:5432/rgbpp
CKB_RPC_URL=https://testnet.ckb.dev/rpc
# CKB_INDEXER_RPC_URL=https://testnet.ckb.dev/indexer
# Left commented: config/{mainnet,testnet}.toml already carry the first block where
# each deployment's RGB++ lock appears on chain, confirmed by querying it. Setting
# these here silently overrides that.
# CKB_START_BLOCK=12663286
# REORG_LAG=24
BTC_SOURCE=esplora
BTC_BASE_URL=https://mempool.space/testnet/api
API_BIND=0.0.0.0:8080
RUST_LOG=info,sqlx=warn
LOG_FORMAT=text

# Throughput. These differ by an order of magnitude between a rate-limited public
# endpoint and self-hosted infrastructure, which is why they are overridable here;
# every other tuning knob lives only in the TOML config.
#
# Self-hosted CKB node + electrs:
# CKB_PAGE_LIMIT=1000
# CKB_BATCH_BLOCKS=2000
# CKB_FETCH_CONCURRENCY=32          # concurrent get_transaction per round
# CKB_POLL_INTERVAL_SECS=2
# BTC_MAX_CONCURRENCY=64
# BTC_MIN_REQUEST_INTERVAL_MS=0     # 50ms is a global 20 req/s ceiling; 0 removes it
# DB_MAX_CONNECTIONS=32

# docker compose only
# POSTGRES_USER=rgbpp
# POSTGRES_PASSWORD=rgbpp
# POSTGRES_DB=rgbpp
# POSTGRES_PORT=5432
# API_PORT=8080
# IMAGE_TAG=latest
# RGBPP_CONFIG=/app/config/mainnet.toml
