# Environment overrides. Every value here also lives in the TOML config; the
# environment wins, so one image can serve several deployments.
DATABASE_URL=postgres://rgbpp:rgbpp@localhost:5432/rgbpp
CKB_RPC_URL=https://testnet.ckb.dev/rpc
# CKB_INDEXER_RPC_URL=https://testnet.ckb.dev/indexer
CKB_START_BLOCK=9000000
REORG_LAG=24
BTC_SOURCE=esplora
BTC_BASE_URL=https://mempool.space/testnet/api
API_BIND=0.0.0.0:8080
RUST_LOG=info,sqlx=warn
LOG_FORMAT=text

# docker compose only
# POSTGRES_USER=rgbpp
# POSTGRES_PASSWORD=rgbpp
# POSTGRES_DB=rgbpp
# POSTGRES_PORT=5432
# API_PORT=8080
# IMAGE_TAG=latest
# RGBPP_CONFIG=/app/config/mainnet.toml
